/target
/.env
# Ignore the locally-installed compound-engineering plugin under .github
# (agents/, skills/, copilot configs) but DO track real CI workflows.
.github/*
!.github/workflows/
docs/plans/
todos/
crates/tests/e2e/reports/
# Live-suite run artifacts (per-test JSON, aggregate, judge, generated summary).
# Tests now write to the repo-root reports dir; CI uploads these as artifacts.
tests/e2e/reports/*.json
tests/e2e/reports/latest-summary.md

# Bulky per-run replica artifacts (skill dumps, worker logs, raw extraction JSON).
# The committed VALIDATION-REPORT.md (force-added) is the durable T10 evidence.
tests/e2e/reports/replica-run/

# Claude Code local state (per-machine memory + session transcripts; never committed).
.claude/projects/

# Per-run e2e console logs and run-scoped report trees (transient artifacts; CI
# uploads them). Same policy as the reports/*.json + replica-run/ ignores above.
tests/e2e/reports/console-*.log
tests/e2e/reports/runs/

# Python bytecode
__pycache__/
*.pyc
